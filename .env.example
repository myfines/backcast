OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# tavily or brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
BACKCAST_DB=backcast.sqlite3
# Backend-only secret; required for manual resolution and evidence annotations.
REVIEW_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Optional isolated pyzhihu-cli interpreter and local session file.
ZHIHU_PYTHON=
ZHIHU_COOKIE_FILE=
# library or zhiarchive; ZhiArchive runs as a separate optional collector.
ZHIHU_BACKEND=library
ZHIARCHIVE_MCP_URL=http://127.0.0.1:9090/mcp/
# Server-side only. Never expose to the frontend or analyst model.
ZHIARCHIVE_TOKEN=
# Server-to-server analyst callback token; never put this in frontend code.
RESEARCH_WORKER_TOKEN=
